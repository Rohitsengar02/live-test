# --- LiveKit (Cloud or self-hosted) ---
# For LiveKit Cloud:
# LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud
# LIVEKIT_PUBLIC_URL=wss://<project-subdomain>.livekit.cloud
# LIVEKIT_API_KEY=API...
# LIVEKIT_API_SECRET=...
#
# For local self-hosted:
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_change_me_to_32_chars_min_xx
# How the Next.js server reaches LiveKit's API
LIVEKIT_URL=http://127.0.0.1:7880
# How browsers reach LiveKit. Leave EMPTY when behind Caddy (same origin, wss://<host>/rtc).
# For plain `npm run dev` on one machine use ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# --- Cache / realtime bus (Valkey = open-source Redis) ---
REDIS_URL=redis://localhost:6379

# --- Python moderation service (NudeNet + toxic-bert) ---
MODERATOR_URL=http://localhost:8000

# --- App ---
MOD_PASSWORD=admin123
# mask = deliver profanity as ***** ; block = reject the whole message
CHAT_POLICY=mask
